# ----------------------------------------------------------
#  HealthSense AI — Environment Variables Template
#
#  HOW TO USE:
#  1. Copy this file:  cp .env.example .env
#  2. Fill in your real values in .env
#  3. NEVER commit .env to Git — it is in .gitignore
#  4. On Render: add these in Dashboard > Environment
# ----------------------------------------------------------

# -- Supabase (get from supabase.com ? Settings ? API) --
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# -- App Config --
ENVIRONMENT=development
PORT=8000

# -- JWT Secret (generate a random 32+ char string) --
# Example: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-your-random-secret-string

# -- CORS (your frontend URL on Render) --
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.onrender.com

# -- Rate Limiting --
RATE_LIMIT_PER_MINUTE=60
